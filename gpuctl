#!/usr/bin/env bash
# gpuctl — the one command for turning a GPU on and off for this project.
#
#   ./gpuctl up <model> [--hold 2h] [--serve]   launch the instance the model needs, lease it to
#                                               you, (optionally) ship the repo and start vLLM
#   ./gpuctl down [name | --all] [--yes]        terminate your instance(s); --all = every sh-*
#   ./gpuctl status                             what is alive, what it costs, busy or idle
#   ./gpuctl hold <ttl> [name]                  "I'm working on it" — extend the lease
#   ./gpuctl release [name]                     drop the lease so the watchdog may reap it
#   ./gpuctl ssh [name]                         open a shell on it
#   ./gpuctl reap                               run the watchdog now (what CI does every 15 min)
#
# Safety model: an instance stays alive only while it is LEASED (a job claimed it, with an
# expiry) or a harness process is running on it. `./gpuwatch` — run by CI every 15 minutes
# — terminates anything else carrying this project's name prefix. `up` leases for --hold
# (default 2h); when your session runs long, `hold` again. Forget, and it turns itself off.
#
# Names: manual instances are "sh-<user>-<model>", CI's are "sh-ci-<model>-<run>-<attempt>".
# Only "sh-*" is ever touched by anything in this repo.
#
# Env: LAMBDA_API_KEY (required), LAMBDA_SSH_KEY, LAMBDA_FS (required for --serve),
#      VLLM_VERSION (required for --serve), LAMBDA_IMAGE (family:version — the GPU DRIVER
#      ships with it; unset lets Lambda pick an older build), WEIGHTS_DIR_OVERRIDE,
#      VENV_NAME (harness-venv),
#      GPU_PROJECT_PREFIX (sh-)
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PREFIX="${GPU_PROJECT_PREFIX:-sh-}"
ME="${GPU_USER:-${USER:-me}}"
SSH_USER="${SSH_USER:-ubuntu}"
VENV_NAME="${VENV_NAME:-harness-venv}"
die() { echo "error: $*" >&2; exit 1; }
info() { echo "==> $*" >&2; }
need_key() { [[ -n "${LAMBDA_API_KEY:-}" ]] || die "LAMBDA_API_KEY not set (https://cloud.lambdalabs.com/api-keys)"; }

mine() { # list my instances: id name ip
  "$HERE/lambdactl" ls | awk -v p="${PREFIX}${ME}-" '$2 ~ "^"p {print $1, $2, $5}'
}
pick() { # [name] -> "id name ip" (my only instance when no name given)
  local want="${1:-}"
  local list; list="$(mine)"
  if [[ -n "$want" ]]; then
    "$HERE/lambdactl" ls | awk -v n="$want" '$2==n {print $1, $2, $5}' | head -1
  else
    local n; n="$(grep -c . <<<"$list" || true)"
    [[ "$n" -eq 1 ]] || die "you have $n instances — name one: $(awk '{print $2}' <<<"$list" | tr '\n' ' ')"
    echo "$list"
  fi
}
sshto() { ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new "$SSH_USER@$1" "${@:2}"; }

weights_dir_for_fs() { # -> absolute WEIGHTS_DIR on the instance
  # Ask the API where the filesystem is actually mounted rather than assuming a layout.
  # Lambda mounts persistent filesystems at /lambda/nfs/<name>; this used to hardcode
  # /home/$SSH_USER/$LAMBDA_FS, which is an ordinary directory on the instance's ephemeral
  # disk. That failure is SILENT — the run succeeds, the weights are simply re-downloaded
  # on the meter every time and lost at teardown.
  if [[ -n "${WEIGHTS_DIR_OVERRIDE:-}" ]]; then echo "$WEIGHTS_DIR_OVERRIDE"; return; fi
  if [[ -z "${LAMBDA_FS:-}" ]]; then
    die "LAMBDA_FS is not set — weights would land on ephemeral disk and be re-downloaded
       (60-160 GB) on every run. Create one (./lambdactl fs lists them) and export its name.
       Set WEIGHTS_DIR_OVERRIDE=<path> only if you deliberately want a throwaway cache."
  fi
  local line; line="$("$HERE/lambdactl" fs "$LAMBDA_FS")" || die "no filesystem named '$LAMBDA_FS'"
  local mount; mount="$(awk '{print $3}' <<<"$line")"
  [[ -n "$mount" && "$mount" != "-" ]] || die "filesystem '$LAMBDA_FS' reports no mount point"
  echo "$mount/models"
}

install_stack() { # ip — build a HERMETIC venv and put the pinned stack in it
  # Why a venv and not `pip install --user`: the Lambda image ships an apt-managed
  # scientific stack in /usr/lib/python3/dist-packages, compiled against numpy 1.x. A
  # --user install upgrades numpy to 2.x underneath it, and the two shadow each other:
  #   apt scipy 1.8.0   -> ImportError: cannot import name 'Inf' from 'numpy'
  #   apt sklearn       -> ValueError: numpy.dtype size changed (ABI mismatch)
  # Both observed on the AI-P167 shakedown, one after the other, each costing a serve
  # attempt on a billing GPU. Upgrading them one at a time does not converge — there is no
  # bound on how many apt packages the transitive import graph touches.
  #
  # A venv without --system-site-packages makes dist-packages invisible, so the conflict
  # cannot arise. It also makes runtime.requirements_lock_sha256 mean something: the lock
  # then describes the environment that actually ran, which is the whole point of recording
  # it. A --user install describes only a delta against an image nobody pinned.
  local ip="$1"
  [[ -n "${VLLM_VERSION:-}" ]] || die "VLLM_VERSION is not set — the serving stack would be
       whatever the image happens to carry, and the run would not be reproducible.
       Pin it (same value CI uses) and re-run: export VLLM_VERSION=x.y.z"

  info "building hermetic venv at ~/$VENV_NAME (dist-packages excluded)"
  sshto "$ip" "test -x ~/$VENV_NAME/bin/python || python3 -m venv ~/$VENV_NAME" \
    || die "could not create the venv on the instance"
  sshto "$ip" "~/$VENV_NAME/bin/pip install -q --upgrade pip setuptools wheel" \
    || die "could not bootstrap pip in the venv"

  # ONE resolution pass. Installing vLLM and then the lock separately lets the second
  # install silently downgrade a dependency out from under the first — that is how
  # huggingface_hub landed on 0.27.1 while vLLM required >=1.27.0, with only a pip
  # warning to show for it. Resolved together, an incompatibility is an error instead.
  # pytest is named explicitly: it is NOT in harness/requirements.lock, and it is the
  # agenttask grader — that adapter runs its hidden tests through a shell as
  # `python3 -m pytest` (GRADER_PYTHON, harness/adapters/agenttask.py). The rest of the repo
  # installs it as its own step (README.md, RUNBOOK.md §1.1, .github/workflows/ci.yml);
  # nothing does that on the instance, and this venv is hermetic, so it cannot fall back on
  # an image-provided one. Without it `./harness/run.sh --suite agenttask` on this box fails
  # tier-3 grading preflight (grading_requirements() -> exit 3) with the stack already
  # installed. In the same resolution pass, so pip weighs it against vLLM's pins.
  info "installing pinned stack: vllm==$VLLM_VERSION + harness/requirements.lock + pytest"
  sshto "$ip" "cd ~/harness-repo && ~/$VENV_NAME/bin/pip install -q 'vllm==$VLLM_VERSION' hf_transfer pytest -r harness/requirements.lock" \
    || die "could not install the pinned stack — the pins in harness/requirements.lock and
       vllm==$VLLM_VERSION may be mutually unsatisfiable. Resolve them together, do not
       install them in sequence."

  # Fail here, cheaply, rather than after the weights load. A vLLM whose torch was built
  # for a newer CUDA than the host driver imports fine and only reveals itself when the
  # engine starts: the AI-P167 shakedown lost three serve attempts to
  # "The NVIDIA driver on your system is too old (found version 12080)".
  # Import vLLM's CUDA platform module, not merely torch. Checking torch alone is what the
  # first version of this guard did, and it was not enough: with a force-installed cu128
  # torch, torch.cuda.is_available() returned True and the check passed — then vLLM died at
  # serve time, AFTER the weights, on
  #     ImportError: libcudart.so.13  (vllm._C_stable_libtorch)
  # because vLLM ships its OWN compiled extension linked against a CUDA runtime that has
  # nothing to do with torch's. The two can disagree. Only importing the thing that will
  # actually serve proves the stack is coherent, and it costs a second here versus a full
  # download there.
  info "checking the GPU is visible to this stack, and that vLLM itself loads"
  sshto "$ip" "~/$VENV_NAME/bin/python -c \"
import sys
import torch
if not torch.cuda.is_available():
    sys.exit('torch %s (cuda %s) cannot see the GPU — the host driver is older than this '
             'build. Pin a vLLM whose torch targets this driver.' % (torch.__version__, torch.version.cuda))
try:
    import vllm.platforms.cuda  # the compiled extension, linked to its own CUDA runtime
except Exception as exc:
    sys.exit('torch works, but vLLM will not load on this host: %s: %s. vLLM ships its own '
             'CUDA extension; a torch that runs here does not imply a vLLM that runs here.'
             % (type(exc).__name__, exc))
print('  gpu ok:', torch.cuda.get_device_name(0), '| torch', torch.__version__, 'cuda', torch.version.cuda, '| vllm loads')
\"" || die "the installed stack cannot serve on this instance — see the message above.
       Nothing has been downloaded yet; pick a compatible VLLM_VERSION and re-run."
}

assert_weights_mounted() { # ip dir — refuse to download onto ephemeral disk
  # Cheap, and it runs BEFORE the download rather than after. If the API's mount point and
  # the instance's reality ever disagree, this is what turns a silent 60-160 GB re-download
  # into a one-line failure while nothing has been spent yet.
  local ip="$1" dir="$2" parent; parent="$(dirname "$dir")"
  if [[ -n "${WEIGHTS_DIR_OVERRIDE:-}" ]]; then
    info "WEIGHTS_DIR_OVERRIDE set — skipping the persistent-mount check (weights are throwaway)"
    sshto "$ip" "mkdir -p '$dir'"; return
  fi
  sshto "$ip" "test -d '$parent'" \
    || die "'$parent' does not exist on the instance — the filesystem did not attach.
       Check its region matches the instance's: ./lambdactl fs '$LAMBDA_FS'"
  sshto "$ip" "mountpoint -q '$parent' || findmnt -T '$parent' | tail -n +2 | grep -qv ' / '" \
    || die "'$parent' exists on the instance but is NOT a mount point — it is ephemeral disk.
       Weights would be re-downloaded on every run. Refusing to start."
  sshto "$ip" "mkdir -p '$dir'"
}

cmd_up() {
  need_key
  local model="" hold="2h" serve=0
  while [[ $# -gt 0 ]]; do case "$1" in
    --hold) hold="$2"; shift 2 ;; --serve) serve=1; shift ;; -*) die "unknown flag $1" ;;
    *) model="$1"; shift ;; esac; done
  [[ -n "$model" ]] || die "usage: gpuctl up <model> [--hold 2h] [--serve]"
  local env="$HERE/models.d/$model.env"; [[ -f "$env" ]] || die "no models.d/$model.env"
  local INSTANCE_TYPE=""; # shellcheck source=/dev/null
  source "$env"
  [[ -n "$INSTANCE_TYPE" ]] || die "$env has no INSTANCE_TYPE"
  [[ "${MULTINODE:-0}" == "1" ]] && die "$model is multi-node; gpuctl handles single-node instances only"

  local name="${PREFIX}${ME}-${model}"
  if [[ -n "$(mine | awk -v n="$name" '$2==n')" ]]; then die "'$name' already exists — gpuctl status / gpuctl down $name"; fi

  info "instance type for $model: $INSTANCE_TYPE"
  local id ip
  read -r id ip < <(INSTANCE_NAME="$name" "$HERE/lambdactl" up "$INSTANCE_TYPE" | tail -n1)
  info "up: $name ($id) at $ip"

  # The lease goes on BEFORE anything else: from this moment the watchdog knows it is yours.
  scp -q -o StrictHostKeyChecking=accept-new "$HERE/gpu-lease" "$SSH_USER@$ip:~/gpu-lease"
  sshto "$ip" "chmod +x ~/gpu-lease && ~/gpu-lease claim '$hold' 'manual:$model' '$ME'"

  if (( serve )); then
    local weights_dir; weights_dir="$(weights_dir_for_fs)"
    info "weights dir: $weights_dir"
    info "shipping the repo and starting vLLM (this is the slow part — weights download on first use)"
    # --no-xattrs: bsdtar on macOS records com.apple.provenance as an extended-header
    # keyword, and GNU tar on the instance prints a warning line for EVERY file it does
    # not recognise — ~30 lines that bury anything real in the upload output.
    # .git SHIPS. harness/manifest.py resolves harness.repo_git_sha with `git rev-parse
    # HEAD`, and that field is REQUIRED provenance (CONTRACTS.md §2) — not merely nice to
    # have. Without it run.sh does not produce a nonconformant run, it refuses to start:
    #     error: manifest: REQUIRED provenance could not be resolved: harness.repo_git_sha
    #     manifest build failed (exit 3)
    # So excluding .git made the entire by-hand path in RUNBOOK §1.4 incapable of running
    # the harness at all, on any suite — discovered on the AI-P167 shakedown, after the
    # instance was up, the stack installed and vLLM serving. benchmark.yml has always
    # shipped the whole checkout for precisely this reason, with a comment saying so; the
    # two paths simply disagreed, and only the CI one was ever exercised.
    # It costs 2.5 MB.
    tar --no-xattrs -czf /tmp/gpuctl-repo.tgz -C "$HERE" --exclude=.github --exclude=.state .
    scp -q /tmp/gpuctl-repo.tgz "$SSH_USER@$ip:~/"
    sshto "$ip" "mkdir -p ~/harness-repo && tar -xzf ~/repo.tgz -C ~/harness-repo 2>/dev/null || tar -xzf ~/gpuctl-repo.tgz -C ~/harness-repo"
    assert_weights_mounted "$ip" "$weights_dir"
    install_stack "$ip"
    # modelctl must use the venv for BOTH jobs: HARNESS_PYTHON drives the weights download
    # (huggingface_hub lives in the venv, not in the system python), VLLM_BIN drives the
    # server. Leaving either pointed at the system interpreter reintroduces the apt/pip
    # split this venv exists to remove.
    sshto "$ip" "cd ~/harness-repo && WEIGHTS_DIR='$weights_dir' \
      HARNESS_PYTHON=\$HOME/$VENV_NAME/bin/python VLLM_BIN=\$HOME/$VENV_NAME/bin/vllm \
      ./modelctl serve '$model'"
  fi
  cat >&2 <<EOF

  $name is leased to you for $hold. It will be TERMINATED by the watchdog once the lease
  expires and no harness process is running — extend with:  ./gpuctl hold 4h
  shell:  ./gpuctl ssh          off:  ./gpuctl down          cost: ./gpuctl status
EOF
  echo "$id $ip"
}

cmd_down() {
  need_key
  local yes=0 all=0 name=""
  for a in "$@"; do case "$a" in --yes|-y) yes=1 ;; --all) all=1 ;; *) name="$a" ;; esac; done
  local targets
  if (( all )); then
    targets="$("$HERE/lambdactl" ls | awk -v p="$PREFIX" '$2 ~ "^"p {print $1, $2}')"
  elif [[ -n "$name" ]]; then
    targets="$("$HERE/lambdactl" ls | awk -v n="$name" '$2==n {print $1, $2}')"
  else
    targets="$(mine | awk '{print $1, $2}')"
  fi
  [[ -n "$targets" ]] || { info "nothing to terminate"; return 0; }
  echo "will terminate:" >&2; sed 's/^/   /' <<<"$targets" >&2
  if (( ! yes )); then read -r -p "proceed? [y/N] " ans; [[ "$ans" =~ ^[Yy]$ ]] || die "aborted"; fi
  while read -r id _; do [[ -n "$id" ]] && "$HERE/lambdactl" down "$id"; done <<<"$targets"
}

cmd_status() { need_key; "$HERE/gpuwatch" --dry-run; }
cmd_reap()   { need_key; "$HERE/gpuwatch"; }

cmd_hold() {
  need_key
  [[ $# -ge 1 ]] || die "usage: gpuctl hold <ttl> [name]"
  local ttl="$1"; read -r _ name ip < <(pick "${2:-}")
  sshto "$ip" "~/harness-repo/gpu-lease renew '$ttl' 2>/dev/null || ~/gpu-lease renew '$ttl' 2>/dev/null || (~/gpu-lease claim '$ttl' 'manual' '$ME')"
  info "$name held for $ttl"
}
cmd_release() {
  need_key; read -r _ name ip < <(pick "${1:-}")
  sshto "$ip" "~/harness-repo/gpu-lease release 2>/dev/null || ~/gpu-lease release"
  info "$name released — the watchdog may terminate it within 15 minutes"
}
cmd_ssh() { need_key; read -r _ name ip < <(pick "${1:-}"); info "$name"; exec ssh -o StrictHostKeyChecking=accept-new "$SSH_USER@$ip"; }

case "${1:-}" in
  up)      shift; cmd_up "$@" ;;
  down)    shift; cmd_down "$@" ;;
  status)  cmd_status ;;
  hold)    shift; cmd_hold "$@" ;;
  release) shift; cmd_release "$@" ;;
  ssh)     shift; cmd_ssh "$@" ;;
  reap)    cmd_reap ;;
  *) sed -n '2,11p' "$0" >&2; exit 1 ;;
esac
