# Raw results never enter git history (CONTRACTS §7.4, codex invariant 2).
# Consent for the agenttask suite is unresolved — trajectories must not become permanent
# history before that decision. Enforced mechanically by `./resultsctl verify --git-hygiene`.
results/
dist/
*.tar.gz
**/trajectories/
**/results.jsonl
**/patches/
**/logs/
**/env/
**/workspaces/
prompt-preview.txt

# Manifests, checksums, aggregate tables and the run index ARE committed — keep them.
!**/run-manifest.json
!**/SHA256SUMS
!index.jsonl

# Rendered figures are derived artefacts: one command (analysis/plots.py) regenerates them
# byte-for-byte from the committed summary.json, so the PNGs themselves are not history.
analysis/figures/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Local state
.state/
.DS_Store

# smoke/run-smoke.sh writes a throwaway model profile here while it runs. It is a test
# fixture, not a study model: EXTRA_ARGS is empty, so committing it fails ci.yml's
# "Every model declares a tool-call parser" guard — and it leaves the tree dirty, which
# marks any run made from this checkout flags.nonconformant.
models.d/smoke-model.env
