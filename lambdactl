#!/usr/bin/env bash
# lambdactl — bring Lambda Cloud GPU instances up and down via the API.
# Companion to modelctl: lambdactl owns the machine, modelctl owns the model.
#
#   ./lambdactl types                       instance types + availability
#   ./lambdactl up <instance-type> [region] launch, wait until active, print IP
#   ./lambdactl ls                          running instances
#   ./lambdactl fs [name]                   persistent filesystems: "<name> <region> <mount-point>"
#   ./lambdactl images [region]             available images: "<family> <version> <id>"
#   ./lambdactl ip <id|name>                public IP of an instance
#   ./lambdactl down <id|name>              terminate one instance (a name matching >1 is an error)
#   ./lambdactl down --all-named <name>     terminate EVERY instance carrying that name (CI teardown)
#   ./lambdactl down --all                  terminate EVERYTHING (CI safety net)
#   ./lambdactl reap [hours] [name-prefix]  terminate instances older than N hours (default 24)
#
# Env:
#   LAMBDA_API_KEY   required — https://cloud.lambdalabs.com/api-keys
#   LAMBDA_SSH_KEY   name of the SSH key registered in Lambda (default: first key)
#   LAMBDA_FS        name of persistent filesystem to attach (optional, region-bound)
#   LAMBDA_IMAGE     "family:version" or an image id. THE GPU DRIVER SHIPS WITH THE IMAGE:
#                    unset means Lambda picks, and its default is not the newest build.
#   INSTANCE_NAME    name tag for launched instance (default: harness-run)
set -euo pipefail

API="https://cloud.lambdalabs.com/api/v1"
[[ -n "${LAMBDA_API_KEY:-}" ]] || { echo "error: LAMBDA_API_KEY not set" >&2; exit 1; }

req() { # method path [json-body]
  local method="$1" path="$2" body="${3:-}"
  if [[ -n "$body" ]]; then
    curl -sf -X "$method" "$API$path" -H "Authorization: Bearer $LAMBDA_API_KEY" \
      -H 'Content-Type: application/json' -d "$body"
  else
    curl -sf -X "$method" "$API$path" -H "Authorization: Bearer $LAMBDA_API_KEY"
  fi
}

resolve_id() { # accept instance id or name; prints exactly one id, or nothing if none matches.
  # A name that matches MORE THAN ONE instance is an error, never a silent first-match: CI
  # re-run attempts can leave a still-terminating instance carrying the same name, and
  # picking it would leave the live one billing. Use `down --all-named` for that case.
  local q="$1"
  req GET /instances | python3 -c "
import json,sys
q=sys.argv[1]
ids=[i['id'] for i in json.load(sys.stdin)['data'] if i['id']==q or i.get('name')==q]
if len(ids)>1:
    print('error: %r matches %d instances: %s -- use: ./lambdactl down --all-named %s' % (q,len(ids),' '.join(ids),q), file=sys.stderr)
    sys.exit(1)
print(ids[0] if ids else '')
" "$q"
}

resolve_all_named() { # every instance id whose name equals $1 (space-separated, may be empty)
  local q="$1"
  req GET /instances | python3 -c "
import json,sys
q=sys.argv[1]
print(' '.join(i['id'] for i in json.load(sys.stdin)['data'] if i.get('name')==q))
" "$q"
}

cmd_types() {
  req GET /instance-types | python3 -c "
import json,sys
d=json.load(sys.stdin)['data']
for name,t in sorted(d.items()):
    regions=[r['name'] for r in t['regions_with_capacity_available']]
    price=t['instance_type']['price_cents_per_hour']/100
    avail=', '.join(regions) if regions else '—'
    print(f\"{name:34s} \${price:>7.2f}/hr  {avail}\")
"
}

cmd_up() {
  local itype="$1" region="${2:-}"
  local name="${INSTANCE_NAME:-harness-run}"

  if [[ -z "$region" ]]; then
    region="$(req GET /instance-types | python3 -c "
import json,sys
t=json.load(sys.stdin)['data'].get('$itype')
rs=t['regions_with_capacity_available'] if t else []
print(rs[0]['name'] if rs else '')
")"
    [[ -n "$region" ]] || { echo "error: no capacity for $itype in any region (see ./lambdactl types)" >&2; exit 1; }
  fi

  local sshkey="${LAMBDA_SSH_KEY:-}"
  if [[ -z "$sshkey" ]]; then
    sshkey="$(req GET /ssh-keys | python3 -c "import json,sys; d=json.load(sys.stdin)['data']; print(d[0]['name'] if d else '')")"
    [[ -n "$sshkey" ]] || { echo "error: no SSH key registered in Lambda" >&2; exit 1; }
  fi

  local fs_json="[]"
  [[ -n "${LAMBDA_FS:-}" ]] && fs_json="[\"$LAMBDA_FS\"]"

  # Pin the image, because the GPU DRIVER ships with it and the driver decides which CUDA
  # runtime — and therefore which vLLM — can run at all. Left unset, Lambda picks, and its
  # pick is not the newest build: two AI-P167 shakedown runs landed on driver 570.148.08
  # (CUDA 12.8) and could not run any vLLM newer than 0.19.1, while the newest published
  # image carries 580.126.20 (CUDA 13.0) and runs current vLLM fine. Same account, same
  # week, same command — a difference the study would otherwise have absorbed silently.
  #
  # LAMBDA_IMAGE takes "family:version" (resolved per region, since ids differ by region for
  # the same build) or a raw image id. Unset keeps the old floating behaviour and says so.
  local image_json=""
  if [[ -n "${LAMBDA_IMAGE:-}" ]]; then
    local img_id="$LAMBDA_IMAGE"
    if [[ "$LAMBDA_IMAGE" == *:* ]]; then
      local fam="${LAMBDA_IMAGE%%:*}" ver="${LAMBDA_IMAGE##*:}"
      img_id="$(req GET /images | python3 -c "
import json,sys
fam, ver, region = sys.argv[1], sys.argv[2], sys.argv[3]
for i in json.load(sys.stdin)['data']:
    if i.get('family') == fam and i.get('version') == ver \
       and (i.get('region') or {}).get('name') == region:
        print(i['id']); break
" "$fam" "$ver" "$region")"
      [[ -n "$img_id" ]] || { echo "error: no image $fam:$ver in $region (./lambdactl images)" >&2; exit 1; }
    fi
    image_json=", \"image\": {\"id\": \"$img_id\"}"
    echo "==> image: $LAMBDA_IMAGE -> $img_id" >&2
  else
    echo "==> image: UNPINNED — Lambda chooses, and its choice carries the GPU driver." >&2
    echo "==>        Set LAMBDA_IMAGE=family:version for a reproducible stack." >&2
  fi

  echo "==> launching $itype in $region (ssh key: $sshkey, fs: ${LAMBDA_FS:-none})" >&2
  local id
  id="$(req POST /instance-operations/launch "{
    \"region_name\": \"$region\",
    \"instance_type_name\": \"$itype\",
    \"ssh_key_names\": [\"$sshkey\"],
    \"file_system_names\": $fs_json,
    \"name\": \"$name\"$image_json
  }" | python3 -c "import json,sys; print(json.load(sys.stdin)['data']['instance_ids'][0])")"
  # emit the id IMMEDIATELY — if the wait below fails, the caller still knows what to terminate
  echo "==> instance $id (name: $name) — waiting for active" >&2
  echo "launched_id=$id" >&2

  local ip="" status=""
  for _ in $(seq 1 90); do
    read -r status ip < <(req GET "/instances/$id" | python3 -c "
import json,sys; i=json.load(sys.stdin)['data']
print(i['status'], i.get('ip') or '-')")
    [[ "$status" == "active" && "$ip" != "-" ]] && break
    printf '.' >&2; sleep 10
  done
  echo >&2
  [[ "$status" == "active" ]] || { echo "error: instance $id not active after 15m (status: $status)" >&2; exit 1; }

  echo "==> waiting for SSH" >&2
  for _ in $(seq 1 30); do
    ssh -o StrictHostKeyChecking=accept-new -o ConnectTimeout=5 -o BatchMode=yes "ubuntu@$ip" true 2>/dev/null && break
    printf '.' >&2; sleep 10
  done
  echo >&2
  echo "==> up: $id  ubuntu@$ip" >&2
  # machine-readable line for CI:
  echo "$id $ip"
}

cmd_ls() { # one line per instance: <id> <name> <type> <status> <ip>. A failed API call FAILS —
           # CI teardown reads this listing to confirm termination, so it must not read as "empty".
  req GET /instances | python3 -c "
import json,sys
for i in json.load(sys.stdin)['data']:
    print(f\"{i['id']}  {i.get('name') or '-':20s} {i['instance_type']['name']:30s} {i['status']:10s} {i.get('ip') or '-'}\")
"
}

cmd_fs() { # [name] -> one line per filesystem: <name> <region> <mount-point>
  # The mount point is NOT derivable from the name. Lambda mounts persistent filesystems
  # at /lambda/nfs/<name>, not under $HOME, and the API is the only authority on it — so
  # WEIGHTS_DIR is built from this rather than from a guess. Getting it wrong is silent:
  # the weights land on the instance's ephemeral disk, the run works, and 60-160 GB is
  # re-downloaded on the meter every time and thrown away at teardown.
  req GET /file-systems | python3 -c "
import json,sys
want = sys.argv[1] if len(sys.argv) > 1 and sys.argv[1] else None
rows = [f for f in json.load(sys.stdin)['data'] if want is None or f.get('name') == want]
if want is not None and not rows:
    sys.stderr.write('error: no filesystem named %r on this account\n' % want)
    sys.exit(1)
for f in rows:
    print('%s %s %s' % (f.get('name'), (f.get('region') or {}).get('name') or '-',
                        f.get('mount_point') or '-'))
" "${1:-}"
}

cmd_images() { # [region] -> "<family> <version> <id>", newest first
  req GET /images | python3 -c "
import json,sys
want = sys.argv[1] if len(sys.argv) > 1 and sys.argv[1] else None
rows = [i for i in json.load(sys.stdin)['data']
        if want is None or (i.get('region') or {}).get('name') == want]
seen = set()
for i in sorted(rows, key=lambda x: (x.get('family') or '', x.get('version') or ''), reverse=True):
    key = (i.get('family'), i.get('version'), (i.get('region') or {}).get('name'))
    if key in seen: continue
    seen.add(key)
    print('%-22s %-16s %-16s %s' % (i.get('family'), i.get('version'),
                                    (i.get('region') or {}).get('name') or '-', i.get('id')))
" "${1:-}"
}

cmd_ip() {
  local id; id="$(resolve_id "$1")" || exit 1
  [[ -n "$id" ]] || { echo "error: no instance '$1'" >&2; exit 1; }
  req GET "/instances/$id" | python3 -c "import json,sys; print(json.load(sys.stdin)['data'].get('ip') or '')"
}

terminate_ids() { # space-separated ids on stdin/args
  local ids_json
  ids_json="$(printf '%s\n' "$@" | python3 -c "import json,sys; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))")"
  [[ "$ids_json" != "[]" ]] || { echo "==> nothing to terminate"; return 0; }
  echo "==> terminating: $*"
  req POST /instance-operations/terminate "{\"instance_ids\": $ids_json}" >/dev/null
  echo "==> done"
}

cmd_down() {
  if [[ "${1:-}" == "--all" ]]; then
    local ids
    ids="$(req GET /instances | python3 -c "import json,sys; print(' '.join(i['id'] for i in json.load(sys.stdin)['data']))")"
    # shellcheck disable=SC2086
    terminate_ids $ids
  elif [[ "${1:-}" == "--all-named" ]]; then
    local name="${2:-}"
    [[ -n "$name" ]] || { echo "usage: ./lambdactl down --all-named <name>" >&2; exit 1; }
    local ids; ids="$(resolve_all_named "$name")"
    if [[ -z "$ids" ]]; then echo "==> no instance named '$name'"; return 0; fi
    # shellcheck disable=SC2086
    terminate_ids $ids
  else
    local id; id="$(resolve_id "$1")" || exit 1
    [[ -n "$id" ]] || { echo "error: no instance '$1'" >&2; exit 1; }
    terminate_ids "$id"
  fi
}

cmd_reap() {
  local max_h="${1:-24}" prefix="${2:-}"
  local ids
  ids="$(req GET /instances | python3 -c "
import json,sys,datetime
max_s=$max_h*3600
prefix='$prefix'
now=datetime.datetime.now(datetime.timezone.utc)
old=[]
for i in json.load(sys.stdin)['data']:
    ts=i.get('launched_at')
    if not ts: continue
    if prefix and not (i.get('name') or '').startswith(prefix): continue
    age=(now-datetime.datetime.fromisoformat(ts.replace('Z','+00:00'))).total_seconds()
    if age>max_s: old.append(i['id'])
print(' '.join(old))
")"
  if [[ -n "$ids" ]]; then
    echo "==> reaping instances older than ${max_h}h${prefix:+ (name prefix: $prefix)}: $ids"
    # shellcheck disable=SC2086
    terminate_ids $ids
  else
    echo "==> nothing older than ${max_h}h${prefix:+ (name prefix: $prefix)}"
  fi
}

case "${1:-}" in
  types) cmd_types ;;
  up)    [[ $# -ge 2 ]] || { echo "usage: ./lambdactl up <instance-type> [region]" >&2; exit 1; }; cmd_up "$2" "${3:-}" ;;
  ls)    cmd_ls ;;
  fs)    cmd_fs "${2:-}" ;;
  images) cmd_images "${2:-}" ;;
  ip)    [[ $# -ge 2 ]] || { echo "usage: ./lambdactl ip <id|name>" >&2; exit 1; }; cmd_ip "$2" ;;
  down)  [[ $# -ge 2 ]] || { echo "usage: ./lambdactl down <id|name> | --all-named <name> | --all" >&2; exit 1; }; cmd_down "$2" "${3:-}" ;;
  reap)  cmd_reap "${2:-}" "${3:-}" ;;
  *) sed -n '2,14p' "$0"; exit 1 ;;
esac
