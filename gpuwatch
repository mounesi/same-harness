#!/usr/bin/env bash
# gpuwatch — the watchdog. Terminates any instance of THIS project that is not doing a job.
#
#   ./gpuwatch [--dry-run] [--json]
#
# For every Lambda instance whose name starts with $GPU_PROJECT_PREFIX (default "sh-"):
#   1. ask the machine itself (ssh → ./gpu-lease status): unexpired lease? harness process?
#   2. decide:
#        busy                      keep
#        idle                      TERMINATE  (no lease, no job process — the classic leak)
#        idle but GPU visibly busy keep + WARN (unleased manual work — run `gpuctl hold`)
#        unreachable               keep while younger than $UNREACHABLE_GRACE_MIN, then TERMINATE
#        younger than $IDLE_GRACE_MIN                     keep (still booting / provisioning)
#        older than $MAX_AGE_H                            TERMINATE regardless
#   3. spend cap: if the accrued cost of everything alive exceeds $MAX_ACCRUED_USD,
#      TERMINATE EVERYTHING and exit 1 loudly.
#
# Anything NOT carrying the project prefix is never touched — this repo must not be able to
# kill instances that belong to something else on the same account.
#
# Env:   LAMBDA_API_KEY (required)   GPU_PROJECT_PREFIX=sh-   IDLE_GRACE_MIN=20
#        UNREACHABLE_GRACE_MIN=30    MAX_AGE_H=24              MAX_ACCRUED_USD=500
#        GPU_IDLE_UTIL_MAX=5 (percent)   SSH_USER=ubuntu       GITHUB_STEP_SUMMARY (optional)
# Exit:  0 nothing wrong (terminations by the idle/age rules are reported as warnings)
#        1 spend cap tripped or the API failed — a human must look
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
API="https://cloud.lambdalabs.com/api/v1"
PREFIX="${GPU_PROJECT_PREFIX:-sh-}"
IDLE_GRACE_MIN="${IDLE_GRACE_MIN:-20}"
UNREACHABLE_GRACE_MIN="${UNREACHABLE_GRACE_MIN:-30}"
MAX_AGE_H="${MAX_AGE_H:-24}"
MAX_ACCRUED_USD="${MAX_ACCRUED_USD:-500}"
GPU_IDLE_UTIL_MAX="${GPU_IDLE_UTIL_MAX:-5}"
SSH_USER="${SSH_USER:-ubuntu}"
DRY=0; JSON=0; SELFTEST=0
for a in "$@"; do case "$a" in --dry-run) DRY=1 ;; --json) JSON=1 ;; --self-test) SELFTEST=1 ;; *) echo "usage: gpuwatch [--dry-run] [--json] [--self-test]" >&2; exit 2 ;; esac; done

# --- self-test: the two things that silently disabled every age guard -------------------
#
# This exists because of a defect that cost real money and was invisible for the life of
# the file: the inventory read `launched_at` from the Lambda API, and the API returns no
# temporal field at all. `age` was therefore ALWAYS "?", and every guard written as
# `[[ "$age" != "?" && ... ]]` silently evaluated to false. Four of them: the unreachable
# reap, the no-tool reap, the MAX_AGE_H hard cap, and the accrued-cost total feeding the
# spend cap. Nothing warned; a dry run just printed "?m" and "keep".
#
# So both halves of the replacement are asserted here: that the remote command computes
# minutes correctly, and that the report is still matched after UPTIME_MIN was prepended
# to it (the NO_LEASE_TOOL check used to be a prefix match and broke when it stopped
# being first — caught only because this test existed).
if (( SELFTEST )); then
  fails=0
  ck() { if [[ "$2" == "$3" ]]; then echo "  ok   $1"; else echo "  FAIL $1: got '$2' want '$3'"; fails=1; fi; }

  # The remote command, run against a synthetic /proc/uptime rather than a real host.
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
  printf '3661.42 7200.00\n' >"$tmp/uptime"
  # Braces around the redirect: `read ... < missing 2>/dev/null` still lets the SHELL
  # report the failed redirection on its own stderr. In probe() that is harmless (the whole
  # ssh call is 2>/dev/null), but a self-test that prints an error while passing is exactly
  # the kind of noise that trains people to ignore output.
  remote() { { read -r u _ < "$tmp/uptime"; } 2>/dev/null && echo "UPTIME_MIN=$(( ${u%%.*} / 60 ))" || echo "UPTIME_MIN="; }
  ck "3661.42s of uptime reads as 61 minutes" "$(remote)" "UPTIME_MIN=61"
  printf '59.9 100.0\n' >"$tmp/uptime"
  ck "sub-minute uptime floors to 0, not empty" "$(remote)" "UPTIME_MIN=0"
  rm -f "$tmp/uptime"
  ck "missing /proc/uptime yields an empty value" "$(remote)" "UPTIME_MIN="

  # Report matching, with UPTIME_MIN now ahead of everything.
  rpt="$(printf 'UPTIME_MIN=61\nNO_LEASE_TOOL')"
  ck "NO_LEASE_TOOL still matches when not first" \
     "$(grep -q '^NO_LEASE_TOOL' <<<"$rpt" && echo yes || echo no)" "yes"
  ck "uptime parses out of a multi-line report" "$(sed -n 's/^UPTIME_MIN=//p' <<<"$rpt")" "61"
  rpt="$(printf 'UPTIME_MIN=90\nLEASE=none\nHARNESS_PROCS=0\nGPU_UTIL=0\nVERDICT=idle')"
  ck "lease fields still parse alongside uptime" "$(sed -n 's/^VERDICT=//p' <<<"$rpt")" "idle"
  ck "a bare UNREACHABLE is still recognised" \
     "$([[ "UNREACHABLE" == UNREACHABLE* ]] && echo yes || echo no)" "yes"

  echo; if (( fails )); then echo "SELF-TEST FAILED"; exit 1; else echo "SELF-TEST PASSED"; exit 0; fi
fi

[[ -n "${LAMBDA_API_KEY:-}" ]] || { echo "error: LAMBDA_API_KEY not set" >&2; exit 1; }
req() { curl -sf -X "$1" "$API$2" -H "Authorization: Bearer $LAMBDA_API_KEY" -H 'Content-Type: application/json' ${3:+-d "$3"}; }

# ---- inventory: id name type status ip age_min price_per_hour -------------------------------
INVENTORY="$(req GET /instances | python3 -c '
import json, sys, datetime
data = json.load(sys.stdin)["data"]
now = datetime.datetime.now(datetime.timezone.utc)
prefix = sys.argv[1]
for i in data:
    name = i.get("name") or ""
    if not name.startswith(prefix):
        continue
    ts = i.get("launched_at")
    age = ""
    if ts:
        try:
            age = int((now - datetime.datetime.fromisoformat(ts.replace("Z", "+00:00"))).total_seconds() // 60)
        except ValueError:
            age = ""
    it = i.get("instance_type") or {}
    price = it.get("price_cents_per_hour")
    price = "%.2f" % (price / 100) if isinstance(price, (int, float)) else ""
    print(i["id"], name, it.get("name", "?"), i.get("status", "?"), i.get("ip") or "-", age if age != "" else "?", price or "?")
' "$PREFIX")" || { echo "error: could not list instances" >&2; exit 1; }

# price fallback from the instance-types endpoint when /instances omits it
price_of() { req GET /instance-types | python3 -c 'import json,sys; t=json.load(sys.stdin)["data"].get(sys.argv[1]); print("%.2f" % (t["instance_type"]["price_cents_per_hour"]/100) if t else "?")' "$1" 2>/dev/null || echo "?"; }

probe() { # ip -> UPTIME_MIN + gpu-lease status lines, or "UNREACHABLE"
  # UPTIME_MIN comes first and is emitted UNCONDITIONALLY, before the lease lookup, because
  # it is the only age source that exists. The Lambda API returns no timestamp of any kind
  # on an instance — the record carries actions, file_system_names, firewall_rulesets,
  # hostname, id, image, instance_type, ip, is_reserved, jupyter_token, jupyter_url, name,
  # private_ip, region, ssh_key_names, status, tags, workspace_id, and nothing temporal
  # (verified against the live API 2026-09-10). So the box has to tell us itself.
  #
  # /proc/uptime rather than uptime(1): two fields, seconds since boot, no prose to parse
  # and no locale. Instance age and kernel uptime differ by the seconds before the kernel
  # started, which is immaterial against grace windows measured in tens of minutes.
  ssh -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new \
      "$SSH_USER@$1" 'read -r u _ < /proc/uptime 2>/dev/null && echo "UPTIME_MIN=$(( ${u%%.*} / 60 ))" || echo "UPTIME_MIN="; test -x ~/harness-repo/gpu-lease && ~/harness-repo/gpu-lease status || (test -x ~/gpu-lease && ~/gpu-lease status) || echo NO_LEASE_TOOL' 2>/dev/null \
    || echo UNREACHABLE
}

terminate() { # id
  if (( DRY )); then echo "   (dry-run) would terminate $1" >&2; return 0; fi
  req POST /instance-operations/terminate "{\"instance_ids\": [\"$1\"]}" >/dev/null
}

rows=(); kill_ids=(); total_accrued=0; exit_code=0
while read -r id name itype status ip age price; do
  [[ -n "$id" ]] || continue
  [[ "$price" == "?" ]] && price="$(price_of "$itype")"
  accrued="?"
  if [[ "$age" != "?" && "$price" != "?" ]]; then
    accrued="$(awk -v a="$age" -v p="$price" 'BEGIN{printf "%.2f", a/60*p}')"
    total_accrued="$(awk -v t="$total_accrued" -v x="$accrued" 'BEGIN{printf "%.2f", t+x}')"
  fi

  lease="?"; procs="?"; util="?"; verdict="?"; action="keep"; why=""; age_src="api"
  if [[ "$status" != "active" ]]; then
    action="keep"; why="status=$status"
  else
    report="$(probe "$ip")"
    # The box's own uptime is the age source (see probe()). Only trust it when the API did
    # not supply one, so that if Lambda ever starts returning a launch timestamp it wins.
    up="$(sed -n 's/^UPTIME_MIN=//p' <<<"$report")"
    if [[ "$age" == "?" && -n "$up" && "$up" =~ ^[0-9]+$ ]]; then age="$up"; age_src="uptime"; fi
    # Recompute accrued now that age may be known — the pre-probe pass above could not.
    if [[ "$accrued" == "?" && "$age" != "?" && "$price" != "?" ]]; then
      accrued="$(awk -v a="$age" -v p="$price" 'BEGIN{printf "%.2f", a/60*p}')"
      total_accrued="$(awk -v t="$total_accrued" -v x="$accrued" 'BEGIN{printf "%.2f", t+x}')"
    fi
    # grep -q, not a prefix match: probe() emits UPTIME_MIN first, so NO_LEASE_TOOL and the
    # lease lines are no longer at the head of the report.
    if [[ "$report" == UNREACHABLE* ]]; then
      verdict="unreachable"
      # Age is unknowable here BY CONSTRUCTION — the only source is the box we cannot reach.
      # Keeping silently is what let an unleased instance bill unnoticed, so an
      # unevaluatable guard is announced rather than skipped.
      if [[ "$age" != "?" && "$age" -ge "$UNREACHABLE_GRACE_MIN" ]]; then
        action="TERMINATE"; why="unreachable for >${UNREACHABLE_GRACE_MIN}m"
      elif [[ "$age" == "?" ]]; then
        why="unreachable AND age unknown — the ${UNREACHABLE_GRACE_MIN}m guard cannot be evaluated"
        echo "::warning::$name: $why — check it by hand: ./lambdactl down $id" >&2
      else
        why="unreachable, within grace"
      fi
    elif grep -q '^NO_LEASE_TOOL' <<<"$report"; then
      verdict="no-tool"; why="gpu-lease not installed — provisioned outside this repo?"
      if [[ "$age" != "?" && "$age" -ge "$((IDLE_GRACE_MIN * 3))" ]]; then
        action="TERMINATE"; why="no gpu-lease and idle for >$((IDLE_GRACE_MIN * 3))m"
      elif [[ "$age" == "?" ]]; then
        why="$why — age unknown, so the $((IDLE_GRACE_MIN * 3))m guard cannot be evaluated"
        echo "::warning::$name: $why" >&2
      fi
    else
      lease="$(sed -n 's/^LEASE=//p' <<<"$report")"
      procs="$(sed -n 's/^HARNESS_PROCS=//p' <<<"$report")"
      util="$(sed -n 's/^GPU_UTIL=//p' <<<"$report")"
      verdict="$(sed -n 's/^VERDICT=//p' <<<"$report")"
      job="$(sed -n 's/^LEASE_JOB=//p' <<<"$report")"
      if [[ "$verdict" == "busy" ]]; then
        why="lease=$lease${job:+ ($job)} procs=$procs"
      elif [[ "$age" != "?" && "$age" -lt "$IDLE_GRACE_MIN" ]]; then
        why="idle but younger than ${IDLE_GRACE_MIN}m (booting?)"
      elif [[ -n "$util" && "$util" != "?" && "$util" -gt "$GPU_IDLE_UTIL_MAX" ]]; then
        why="NO LEASE but GPU at ${util}% — unleased work? run: gpuctl hold 2h"
        echo "::warning::$name: $why" >&2
      else
        action="TERMINATE"; why="idle: no lease, no harness process (gpu ${util:-?}%)"
      fi
    fi
  fi
  if [[ "$age" != "?" ]] && (( age >= MAX_AGE_H * 60 )); then action="TERMINATE"; why="older than ${MAX_AGE_H}h ($why)"; fi

  [[ "$action" == "TERMINATE" ]] && kill_ids+=("$id|$name|$why")
  rows+=("| $name | $itype | ${age}m | \$$price | \$$accrued | $lease | $procs | ${util}% | $verdict | **$action** — $why |")
done <<<"$INVENTORY"

# ---- spend cap ---------------------------------------------------------------------------
cap_tripped=0
if awk -v t="$total_accrued" -v c="$MAX_ACCRUED_USD" 'BEGIN{exit !(t>c)}'; then
  cap_tripped=1; exit_code=1
  echo "::error::SPEND CAP: \$$total_accrued accrued across live '$PREFIX*' instances > \$$MAX_ACCRUED_USD — terminating everything" >&2
  kill_ids=()
  while read -r id name _ status _ _ _; do [[ -n "$id" && "$status" == "active" ]] && kill_ids+=("$id|$name|spend cap"); done <<<"$INVENTORY"
fi

# ---- act -----------------------------------------------------------------------------------
for k in "${kill_ids[@]:-}"; do
  [[ -n "$k" ]] || continue
  IFS='|' read -r id name why <<<"$k"
  echo "::warning::terminating $name ($id): $why" >&2
  terminate "$id" || { echo "::error::terminate failed for $name ($id)" >&2; exit_code=1; }
done

# ---- report --------------------------------------------------------------------------------
{
  echo "### gpuwatch — $(date -u +%FT%TZ)$( (( DRY )) && echo ' (dry-run)')"
  echo
  if [[ ${#rows[@]} -eq 0 ]]; then
    echo "No '$PREFIX*' instances alive. Accrued: \$0."
  else
    echo "| name | type | age | \$/h | accrued | lease | procs | gpu | verdict | action |"
    echo "|---|---|---|---|---|---|---|---|---|---|"
    printf '%s\n' "${rows[@]}"
    echo
    echo "Accrued across live instances: **\$$total_accrued** (cap \$$MAX_ACCRUED_USD)$( (( cap_tripped )) && echo ' — **CAP TRIPPED**')"
    echo "Terminated this pass: ${#kill_ids[@]}"
  fi
} | tee -a "${GITHUB_STEP_SUMMARY:-/dev/null}" >&2
(( JSON )) && printf '{"live": %d, "terminated": %d, "accrued_usd": %s, "cap_tripped": %d}\n' "${#rows[@]}" "${#kill_ids[@]}" "$total_accrued" "$cap_tripped"
exit "$exit_code"
