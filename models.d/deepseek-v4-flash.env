# DeepSeek V4 Flash — 284B/13B MoE, retrained agentic checkpoint. 8x H100.
HF_REPO="deepseek-ai/DeepSeek-V4-Flash"            # TODO verify: use the RETRAINED checkpoint repo
TP=8
MAX_MODEL_LEN=262144
# vLLM refuses tool_choice:"auto" without BOTH of these, and the harness agent loop
# sends exactly that on every call — so an attempt cannot even start without them
# (AI-3159). The parser is per-model-family, which is why it lives here rather than
# in the held constants.
# Parser choice: vLLM 0.28.0 ships a parser named for exactly this model version.
EXTRA_ARGS="--trust-remote-code --enable-auto-tool-choice --tool-call-parser deepseek_v4"
INSTANCE_TYPE="gpu_8x_h100_sxm5"
