# GLM-5.3 — 744B/40B MoE (same arch/footprint as 5.2, stronger post-training). 8x B200.
# BLOCKED: open weights delayed by Zhipu (safety review; missed the ~Aug 28 promise).
# No 5.2 fallback per decision 2026-08-29 — if weights aren't out by run day, skip GLM
# and run it from the Phase 3 reserve when they land.
HF_REPO="zai-org/GLM-5.3"                          # TODO verify exact repo id when weights drop
TP=8
MAX_MODEL_LEN=262144
# vLLM refuses tool_choice:"auto" without BOTH of these, and the harness agent loop
# sends exactly that on every call — so an attempt cannot even start without them
# (AI-3159). The parser is per-model-family, which is why it lives here rather than
# in the held constants.
# Parser choice: UNVERIFIED. vLLM 0.28.0 has glm45 and glm47 — there is NO glm53. The repo's
#   chat template does emit <tool_call>/<tools>, so the family format is right, but
#   whether GLM-5.3 is wire-compatible with the 4.7 parser is a GUESS. Confirm on the
#   first serve: a mismatched parser makes tool calls fail to parse, which reads as the
#   MODEL failing rather than the config being wrong.
EXTRA_ARGS="--trust-remote-code --enable-auto-tool-choice --tool-call-parser glm47"
INSTANCE_TYPE="gpu_8x_b200_sxm6"
