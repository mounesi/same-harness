# MiniMax M3 — 428B total / ~23B active MoE, 1M context (we cap at 262144). 4x H100.
# Spec conflict resolved 2026-08-31: 428B/23B is the parameter count; the "~230B" figure
# seen elsewhere is the FP8 WEIGHT SIZE in GB (~230 GB), not a parameter count.
# 230 GB weights + ~30 GB KV at 256k ctx fits 4x H100 SXM5 (320 GB) => TP=4, $15.96/hr.
# If vLLM OOMs on load, go to TP=8 ($31.92/hr) — 4x is deliberately the tighter, cheaper fit.
HF_REPO="MiniMaxAI/MiniMax-M3"
TP=4
MAX_MODEL_LEN=262144
# vLLM refuses tool_choice:"auto" without BOTH of these, and the harness agent loop
# sends exactly that on every call — so an attempt cannot even start without them
# (AI-3159). The parser is per-model-family, which is why it lives here rather than
# in the held constants.
# Parser choice: Exact-version parser in vLLM 0.28.0, and the repo's chat template emits
#   <tool_call>/<tools>, which is what that parser reads.
EXTRA_ARGS="--trust-remote-code --enable-auto-tool-choice --tool-call-parser minimax_m3"
INSTANCE_TYPE="gpu_4x_h100_sxm5"
