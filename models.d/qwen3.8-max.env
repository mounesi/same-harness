# Qwen3.8-Max open weights — 2.4T/95B MoE, native FP8 (~2.5 TB). MULTI-NODE: 2x 8x B200.
# NOTE: accept the custom Qwen3.8-Max License on HF before downloading.
# Run at native FP8 (pp=2 across nodes via Ray) — do NOT squeeze to FP4 (precision confound).
HF_REPO="Qwen/Qwen3.8-2.4T-A95B-FP8"               # TODO verify exact repo id on HF
TP=8
PP=2                                               # pipeline parallel across 2 nodes
MULTINODE=1
MAX_MODEL_LEN=262144
# vLLM refuses tool_choice:"auto" without BOTH of these, and the harness agent loop
# sends exactly that on every call — so an attempt cannot even start without them
# (AI-3159). The parser is per-model-family, which is why it lives here rather than
# in the held constants.
# Parser choice: UNVERIFIED. Chat template emits <tool_call>/<tool_response>/<tools>, same markers
#   as Qwen3-Coder-Next, so the choice is between qwen3_xml (generic Qwen3 XML) and
#   qwen3_coder. Picked the generic one because this is not a coder model. Confirm on
#   the first serve.
EXTRA_ARGS="--trust-remote-code --enable-auto-tool-choice --tool-call-parser qwen3_xml"
INSTANCE_TYPE="gpu_8x_b200_sxm6"   # x2 nodes — multi-node launch not yet CI-supported
