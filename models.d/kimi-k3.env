# Kimi K3 — 2.8T/104B MoE, native MXFP4 (~594 GB). Single 8x B200 node.
# NOTE: accept the Kimi K3 License on HF before downloading.
# Moonshot ships an official vLLM docker image with Kimi Delta Attention — if plain
# vLLM refuses to load, set VLLM_DOCKER_IMAGE and modelctl will run it in docker.
HF_REPO="moonshotai/Kimi-K3"
TP=8
MAX_MODEL_LEN=262144
# vLLM refuses tool_choice:"auto" without BOTH of these, and the harness agent loop
# sends exactly that on every call — so an attempt cannot even start without them
# (AI-3159). The parser is per-model-family, which is why it lives here rather than
# in the held constants.
# Parser choice: vLLM 0.28.0 ships a parser named for exactly this model version.
EXTRA_ARGS="--trust-remote-code --enable-auto-tool-choice --tool-call-parser kimi_k3"
#VLLM_DOCKER_IMAGE="moonshotai/kimi-k3-vllm:latest"  # TODO verify image name in Moonshot's day-0 recipe
INSTANCE_TYPE="gpu_8x_b200_sxm6"
